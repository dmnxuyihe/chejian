# Copy to .env and set your PostgreSQL credentials. Never commit .env.
DATABASE_URL=postgresql://workshop:YOUR_PASSWORD@127.0.0.1:5432/workshop_schedule
PC1_DB_SCHEMA=pc1
PORT=5193
# Use 0.0.0.0 only for a trusted demo LAN, then use the server computer IP.
HOST=127.0.0.1
# Optional real tool-device gateway token (at least 24 random characters).
# Keep blank until a trusted gateway is configured; never commit the actual token.
TOOL_DEVICE_TOKEN=
