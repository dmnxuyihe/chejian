{
  "name": "rail-maintenance-scheduler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "db:init": "node scripts/database.mjs init",
    "db:check": "node scripts/database.mjs check",
    "db:schema": "node scripts/generate-schema.mjs",
    "test:db-init": "node tests/database_init.mjs",
    "test:planning": "node tests/planning_calendar.mjs",
    "test:planning-import": "node tests/planning_import.mjs",
    "test:persistence": "node tests/demo_persistence.mjs && node tests/database_persistence.mjs",
    "test:postgres": "node tests/postgres_integration.mjs",
    "test:postgres:ui": "node tests/postgres_ui.mjs",
    "test:planning:ui": "node tests/planning_page_ui.mjs",
    "start": "node start.js",
    "serve": "node start.js --no-open",
    "test:ui": "node tests/ui_smoke.mjs",
    "test:ui:python": "python tests/ui_smoke.py",
    "test:acceptance": "node tests/v01_acceptance.mjs",
    "test:logic": "node tests/schedule_logic.mjs",
    "test:roles": "node tests/phase_one_roles.mjs",
    "test": "node tests/phase_one_roles.mjs && node tests/schedule_logic.mjs && node tests/v01_acceptance.mjs && node tests/planning_calendar.mjs && node tests/demo_persistence.mjs && node tests/database_persistence.mjs && node tests/ui_smoke.mjs"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
